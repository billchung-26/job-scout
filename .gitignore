# --- secrets: NEVER commit ---
secrets.yaml

# --- runtime state ---
# state.json / rec_state.json / .last_promote are tracked on purpose: GitHub Actions
# runs on a fresh VM every time with no persistent disk, so these must round-trip
# through git or every role looks "first seen today" and promotion re-fires daily.
.last_session_run
logs/
digests/
__pycache__/
*.pyc
.DS_Store

# --- recommendations: publish only the rolling "latest" files ---
recommendations/*
!recommendations/latest.md
!recommendations/latest.csv
!recommendations/latest.xlsx

# (tracked on purpose: companies_auto.yaml, watchlist.md, watchlist.xlsx)
